# Copy this file to .env for local development. Never commit real API keys.
GEMINI_API_KEYS=replace_with_rotated_key_1,replace_with_rotated_key_2
GEMINI_REVIEW_MODEL=gemini-2.5-flash-lite
GEMINI_REVIEW_RPM=12
OCR_DAILY_LIMIT=20

# Required by verify-profile-email when testing email verification.
RESEND_API_KEY=replace_with_resend_key
WORDORIA_EMAIL_FROM=Wordoria <verify@your-domain.example>
